# Tip: for more than one provider, define named profiles in ~/.llmcli/profiles.toml
# (see profiles.toml.example). The plain settings below are used when no profile is active.
# Select a profile by default for this machine/project:
# LLMCLI_PROFILE=nvidia
#
# Provider: ollama, openai_compat
LLMCLI_PROVIDER=ollama

# Default model to use
LLMCLI_MODEL=qwen2.5-coder

# API Endpoint (Local or Remote)
LLMCLI_ENDPOINT=http://localhost:11434

# API Key (Optional for local, required for cloud providers)
LLMCLI_API_KEY=

# Generation Parameters
LLMCLI_CONTEXT_SIZE=8192
LLMCLI_MAX_TOKENS=4096

# Name of the context markdown file (default: CONTEXT.md)
LLMCLI_CONTEXT_FILE=CONTEXT.md

# Optional sampling overrides (leave blank for provider/agent defaults)
LLMCLI_TEMPERATURE=
LLMCLI_TOP_P=

# Optional JSON merged into OpenAI-compatible request bodies, e.g.
# LLMCLI_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":true}}
LLMCLI_EXTRA_BODY=

# --- Example: Google Gemini (OpenAI-compatible) ---
# LLMCLI_PROVIDER=openai_compat
# LLMCLI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/
# LLMCLI_MODEL=<model id from /models>
# LLMCLI_API_KEY=<your Gemini API key>

# --- Example: NVIDIA NIM ---
# LLMCLI_PROVIDER=openai_compat
# LLMCLI_ENDPOINT=https://integrate.api.nvidia.com/v1
# LLMCLI_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# LLMCLI_API_KEY=<your NVIDIA API key>
# LLMCLI_MAX_TOKENS=16384
# LLMCLI_TEMPERATURE=1
# LLMCLI_TOP_P=0.95
# LLMCLI_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":true}}

# --- API keys referenced by profiles (api_key_env in profiles.toml) ---
# Put the real values in ~/.llmcli/.env (not a project .env that could be committed).
# GEMINI_API_KEY=
# NVIDIA_API_KEY=
